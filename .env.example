# Copy this file to .env.local and adjust the values.
# .env.local is ignored by git and must never be committed.
#
# Anything prefixed with NEXT_PUBLIC_ is bundled into the browser build.
# Never put a secret, private key or token behind that prefix.

# Absolute URL used for metadata, canonical links and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
